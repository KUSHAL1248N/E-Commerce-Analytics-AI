# Local development: preserves the original local Ollama + Qwen 2.5 3B setup.
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=YOUR_LOCAL_DASHBOARD_USER
MYSQL_PASSWORD=YOUR_LOCAL_DASHBOARD_PASSWORD
MYSQL_DATABASE=ecommerce_analytics
MYSQL_SSL=false

AI_MYSQL_USER=ai_reader
AI_MYSQL_PASSWORD=YOUR_LOCAL_AI_READER_PASSWORD
